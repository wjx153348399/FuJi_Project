{
  "share": {
    "root": "\\\\SERVER\\Share\\Impedance",
    "username": "YOUR_USERNAME",
    "password": "YOUR_PASSWORD"
  },
  "log": {
    "dir": "\\\\SERVER\\Share\\ZK_LOG"
  },
  "upload": {
    "url": "http://YOUR_SERVER/service-qms/file/importImpedanceData",
    "schedule_time": "08:00",
    "day_offset": 1,
    "max_upload_files": null,
    "dry_run": true,
    "timeout_seconds": 60,
    "retry_count": 2,
    "send_station_code": true,
    "station_field_name": "station_code"
  },
  "scan": {
    "recursive": true,
    "extensions": [".xls", ".xlsx"],
    "exclude_prefixes": ["~$"],
    "exclude_dirs": ["LOG", "log", "logs", "backup"],
    "targets": [
      {
        "station_code": "A10",
        "dir": "ExampleStationDirectoryA",
        "enabled": true
      }
    ]
  },
  "watch": {
    "enabled": false,
    "notice_mode": "log_and_daily_summary"
  }
}
