{
  "share": {
    "root": "\\\\SERVER\\Share\\Impedance",
    "username": "YOUR_USERNAME",
    "password": "YOUR_PASSWORD"
  },
  "log": {
    "dir": "\\\\SERVER\\Share\\ZK_LOG"
  },
  "upload": {
    "url": "http://YOUR_SERVER/service-qms/file/importImpedanceData",
    "schedule_time": "08:00",
    "day_offset": 1,
    "max_upload_files": null,
    "dry_run": false,
    "timeout_seconds": 300,
    "retry_count": 2
  },
  "scan": {
    "recursive": true,
    "extensions": [".xls", ".xlsx"],
    "exclude_prefixes": ["~$"],
    "exclude_dirs": ["LOG", "log", "logs", "backup"],
    "targets": [
      {
        "flow": "A10",
        "dir": "ExampleStationDirectoryA",
        "enabled": true
      },
      {
        "flow": "A50",
        "dir": "ExampleStationDirectoryB",
        "enabled": true
      }
    ]
  },
  "station_config": {
    "source": "json",
    "on_db_error": "fallback_to_json",
    "db": {
      "enabled": false,
      "driver": "sqlserver",
      "odbc_driver": "ODBC Driver 17 for SQL Server",
      "host": "127.0.0.1",
      "port": 1433,
      "database": "YOUR_DATABASE",
      "username": "YOUR_DB_USERNAME",
      "password": "YOUR_DB_PASSWORD",
      "table": "dbo.station_directory_config",
      "connect_timeout_seconds": 5,
      "query_timeout_seconds": 10
    }
  },
  "runtime_log": {
    "db_enabled": true,
    "db_table": "dbo.zk_upload_runtime_log"
  },
  "watch": {
    "enabled": true,
    "notice_mode": "log_and_daily_summary",
    "poll_interval_seconds": 5,
    "debounce_seconds": 5,
    "config_reload_interval_seconds": 5,
    "stable_check_seconds": 2,
    "stable_check_attempts": 3,
    "queue_max_workers": 1
  }
}
